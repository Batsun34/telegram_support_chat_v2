BOT_TOKEN=123456:replace_me
DATABASE_URL=sqlite+aiosqlite:///./support_chat.db
# Telegram ID -> visible moderator name. Example: {"111111111":"Алекс","222222222":"Мария"}
MODERATORS_JSON={"111111111":"Алекс"}
# Reserved for future admin-only actions; moderators can ban/unban in v2.
ADMIN_IDS=111111111
LOG_LEVEL=INFO
DEBOUNCE_SECONDS=10
HISTORY_PAGE_SIZE=10
CHAT_LIST_PAGE_SIZE=10
ACTIVE_HOURS=24
# Temporary moderator workspace is auto-cleaned before Telegram's 48h deletion limit.
VIEW_TTL_HOURS=23
